# Postgres connection string. On Vercel, add the Postgres/Neon integration
# from the Storage tab and it will fill this in for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string — used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Only used the very first time the app runs (to seed the initial team
# password). After that, change the password from the Settings page —
# it's stored (hashed) in the database, not read from this variable again.
TEAM_PASSWORD="z1power2026"
