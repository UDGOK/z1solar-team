# Postgres connection string. On Vercel, add the Postgres/Neon integration
# from the Storage tab and it will fill this in for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Google Sign-In (NextAuth) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (Web application). See README section 5 for exact setup steps.
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxxxx"

# Any long random string — NextAuth uses this to sign/encrypt session tokens.
# Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The full URL of your deployed app (no trailing slash). Locally this is
# http://localhost:3000. On Vercel it's your real domain, e.g.
# https://www.szhholdings.com
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob token — auto-added when you connect Blob storage in the
# Storage tab. Only needed locally if you're testing file uploads from your
# own machine.
BLOB_READ_WRITE_TOKEN=""
