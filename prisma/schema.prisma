generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TeamMember {
  id          String          @id @default(cuid())
  name        String
  title       String?
  email       String?         @unique // Google sign-in identity AND email/password login
  phone       String?
  // Legacy field, retained so existing checks keep working during rollout.
  // "ADMIN" here still means full system access regardless of roleId.
  role        String          @default("MEMBER") // "MEMBER" | "ADMIN"
  roleId      String?
  customRole  Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Email + password login (optional — a person can use Google instead, or both).
  // Set by the person themselves via an invite link; admins never see or set it.
  passwordHash       String?
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  leads       Project[]       @relation("ProjectLead")
  ownedProjects Project[]     @relation("ProjectOwner")
  memberships ProjectMember[]
  access      ProjectAccess[]
  assignedTodos Todo[]        @relation("TodoAssignee")
  createdTodos  Todo[]        @relation("TodoCreator")
  notifications Notification[] @relation("NotificationRecipient")
  sentMessages     Message[]          @relation("MessageSender")
  activities       Activity[]
  savedViews       SavedView[]
  tradeShowAttendance TradeShowAttendee[]
  // Module-level access, set by an admin from the Trade Shows page.
  canViewTradeShows   Boolean @default(true)
  canManageTradeShows Boolean @default(false)
  // Presence. Updated on page loads, throttled so it isn't a write per request.
  lastSeenAt          DateTime?
  messageReceipts  MessageRecipient[]
  subscriptions ReportSubscription[]
  emailOnTaskAssigned Boolean @default(true)
}

// Per-person, per-project weekly report subscription. Admin picks exactly
// which sections each person receives — a person can be subscribed to a
// project's status without ever seeing its financials, and vice versa.
model ReportSubscription {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  enabled          Boolean @default(true)
  includeStatus    Boolean @default(true)
  includeTasks     Boolean @default(true)
  includeKeyDates  Boolean @default(false)
  includeQuestions Boolean @default(false)
  includeFinancials Boolean @default(false)

  lastSentAt DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([projectId, memberId])
}

model Project {
  id           String          @id @default(cuid())
  title        String
  // Optional short label shown on the dashboard highlight card. Falls back to
  // `title` when empty, so existing projects are unaffected.
  highlightTitle String?
  category     String // "Solar & Battery" | "Other Projects" | "Other Matters" | "New Project"
  leadId       String?
  lead         TeamMember?     @relation("ProjectLead", fields: [leadId], references: [id])
  // Whoever created the project. Owners get full control of their own
  // projects without needing an explicit ProjectAccess row.
  ownerId      String?
  owner        TeamMember?     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  talkingPoints TalkingPoint[]
  keyDates     KeyDate[]
  todos        Todo[]
  questions    OpenQuestion[]
  files        ProjectFile[]
  access       ProjectAccess[]
  lineItems    FinancialLineItem[]
  subscriptions ReportSubscription[]

  // financials
  estBudget    Float           @default(0)
  committed    Float           @default(0)
  actualSpend  Float           @default(0)
  q3Proj       Float           @default(0)
  q4Proj       Float           @default(0)
  q1Proj       Float           @default(0)
  q2Proj       Float           @default(0)
  notes        String?

  // Site / location
  address       String?
  city          String?
  state         String?   // 2-letter, drives rebate lookups
  postalCode    String?
  latitude      Float?
  longitude     Float?

  // Owner / client contact
  ownerName     String?
  ownerCompany  String?
  ownerEmail    String?
  ownerPhone    String?
  ownerNotes    String?

  rebates       ProjectRebate[]
  activities    Activity[]

  // progress
  status        String        @default("Planning") // "Planning" | "On Track" | "At Risk" | "Delayed" | "Complete"
  completionPct Int           @default(0) // 0-100, set by the project lead

  archived     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      String?
  tasks     String?

  @@unique([projectId, memberId])
}

model TalkingPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  order     Int     @default(0)
}

model KeyDate {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone String
  date      DateTime?
  order     Int       @default(0)
}

model Todo {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text        String
  done        Boolean     @default(false)
  order       Int         @default(0)
  // Assignee does NOT need ProjectAccess on this project — a task can be
  // handed to anyone on the team. Their access to the task itself is what
  // grants them sight of it (see My Tasks).
  assigneeId  String?
  assignee    TeamMember? @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  createdById String?
  createdBy   TeamMember? @relation("TodoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
}

// In-app notifications (bell + dashboard). Email delivery is layered on top
// of these rows later rather than replacing them.
model Notification {
  id         String     @id @default(cuid())
  recipientId String
  recipient  TeamMember @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type       String     // "TASK_ASSIGNED" | "TASK_DUE_SOON" | "GENERAL"
  title      String
  body       String?
  link       String?    // where clicking it should take them
  read       Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([recipientId, read])
}

model OpenQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  resolved  Boolean @default(false)
  order     Int     @default(0)
}

model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  pathname    String // needed to delete the blob later
  filename    String
  contentType String?
  size        Int
  uploadedAt  DateTime @default(now())
}

// Per-person, per-project permissions, set by an admin.
//
// IMPORTANT: this is a default-DENY model. Absence of a row means the member
// has NO access to that project at all — they won't see it anywhere. Admins
// bypass all of this and always see everything.
//
// `canView` is the master switch: without it, none of the other flags matter.
model ProjectAccess {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  canView             Boolean @default(false) // master switch — see the project at all
  canEditTalkingPoints Boolean @default(false)
  canEditKeyDates     Boolean @default(false)
  canEditTodos        Boolean @default(false)
  canEditQuestions    Boolean @default(false)
  canEditTeam         Boolean @default(false)
  canViewFiles        Boolean @default(false)
  canUploadFiles      Boolean @default(false)
  canViewFinancials   Boolean @default(false)
  canEditFinancials   Boolean @default(false)
  canEditStatus       Boolean @default(false) // status + completion %

  updatedAt DateTime @updatedAt

  @@unique([projectId, memberId])
}

// Project-level financial ledger. Each row is a budget line that can carry
// actual spend, so budget-vs-actual variance is computed per line rather than
// only in aggregate.
model FinancialLineItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String   @default("General") // e.g. Labor, Materials, Equipment, Permits
  description String
  vendor      String?

  // Budget side — amount is qty * unitCost, stored so historical rows keep
  // their value even if the formula changes later.
  qty         Float    @default(1)
  unitCost    Float    @default(0)
  budgetAmount Float   @default(0)

  // Actual side
  actualAmount Float   @default(0)
  invoiceRef   String?
  paidDate     DateTime?
  status       String   @default("Planned") // Planned | Committed | Invoiced | Paid

  notes       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// Incentives tracked per project. Values are entered and verified by a human —
// nothing here is auto-guessed, because wrong incentive figures on a quote are
// worse than no figures.
model ProjectRebate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  authority   String?  // Federal / State / Utility / Local
  category    String   @default("Solar") // Solar | BESS | EV | Efficiency | Other
  incentiveType String @default("Percentage") // Percentage | PerWatt | Fixed | PerKWh
  value       Float    @default(0)
  estimatedAmount Float @default(0)
  status      String   @default("Researching") // Researching | Eligible | Applied | Awarded | Denied
  sourceUrl   String?
  notes       String?
  verifiedAt  DateTime?
  order       Int      @default(0)

  @@index([projectId])
}

// Team messages and alerts. One Message row per send, with a MessageRecipient
// row per person so read state, dismissal, and deletion are all per-person —
// one recipient deleting a message never affects anyone else's copy.
model Message {
  id        String   @id @default(cuid())
  senderId  String?
  sender    TeamMember? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  subject   String
  body      String
  // "MESSAGE" = normal team message
  // "ALERT"   = must be acknowledged; blocks with a modal on next login
  kind      String   @default("MESSAGE")
  priority  String   @default("Normal") // Normal | High | Urgent

  // Threading — a reply points at the message it answers.
  parentId  String?
  parent    Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[] @relation("MessageThread")

  recipients MessageRecipient[]
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MessageRecipient {
  id        String     @id @default(cuid())
  messageId String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  read           Boolean   @default(false)
  readAt         DateTime?
  // Alerts must be explicitly acknowledged before the popup stops appearing.
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  // Soft delete — hides it from this person only.
  deleted        Boolean   @default(false)

  @@unique([messageId, memberId])
  @@index([memberId, read])
}

// Immutable record of what happened on a project. Never edited or deleted by
// users — only appended. Powers the per-project activity feed.
model Activity {
  id        String      @id @default(cuid())
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     TeamMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Denormalised so the feed still reads correctly after someone leaves.
  actorName String

  // e.g. "task.created", "financials.updated", "member.access_changed"
  action    String
  // Human-readable one-liner, pre-rendered at write time.
  summary   String
  // Optional structured detail (before/after values, ids).
  meta      String?
  createdAt DateTime    @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

// A named, reusable filter across tasks or projects.
model SavedView {
  id        String     @id @default(cuid())
  ownerId   String
  owner     TeamMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  scope     String     @default("tasks") // "tasks" | "projects"
  // JSON blob of the filter state — kept opaque so adding new filter
  // dimensions later doesn't require a migration.
  filters   String
  shared    Boolean    @default(false) // visible to the whole team
  createdAt DateTime   @default(now())

  @@index([ownerId])
}

// Trade shows / industry events the team may attend.
model TradeShow {
  id          String   @id @default(cuid())
  name        String
  description String?

  startDate   DateTime
  endDate     DateTime?
  // Free text rather than a time field — real listings say things like
  // "Expo hall 9am–5pm daily", which no time picker captures well.
  timeInfo    String?

  venue       String?
  city        String?
  state       String?
  country     String?  @default("USA")

  websiteUrl      String?
  registrationUrl String?
  // Booth registration usually closes long before the show itself — this is
  // the date that actually causes problems when missed.
  registrationDeadline DateTime?

  priority    String   @default("Medium") // High | Medium | Low
  status      String   @default("Considering") // Considering | Registered | Attending | Attended | Skipped
  boothInfo   String?
  estimatedCost Float  @default(0)
  notes       String?

  attendees   TradeShowAttendee[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
}

model TradeShowAttendee {
  id          String     @id @default(cuid())
  tradeShowId String
  tradeShow   TradeShow  @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status      String     @default("Tentative") // Confirmed | Tentative | Declined
  role        String?    // e.g. "Booth lead", "Technical support"
  notes       String?

  @@unique([tradeShowId, memberId])
}

// A named set of capabilities an admin can define and assign, e.g.
// "Supervisor", "Sub-admin", "Field Tech". Two system roles (Administrator,
// Member) ship by default and can't be deleted.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  // System roles are protected from deletion/renaming.
  isSystem    Boolean @default(false)
  // Higher rank = more authority. Used to stop someone editing a role at or
  // above their own level.
  rank        Int     @default(10)

  // --- Global capabilities ---
  canCreateProjects    Boolean @default(false)
  canDeleteAnyProject  Boolean @default(false)
  canViewAllProjects   Boolean @default(false)
  canEditAllProjects   Boolean @default(false)
  canViewAllFinancials Boolean @default(false)
  canEditAllFinancials Boolean @default(false)
  canManageTeam        Boolean @default(false)
  canManageRoles       Boolean @default(false)
  canSendAlerts        Boolean @default(false)
  canManageTradeShows  Boolean @default(false)
  canViewReports       Boolean @default(false)

  // --- Defaults applied when this person is granted a project ---
  defaultCanEditTalkingPoints Boolean @default(true)
  defaultCanEditKeyDates      Boolean @default(true)
  defaultCanEditTodos         Boolean @default(true)
  defaultCanEditQuestions     Boolean @default(true)
  defaultCanEditTeam          Boolean @default(false)
  defaultCanViewFiles         Boolean @default(true)
  defaultCanUploadFiles       Boolean @default(true)
  defaultCanViewFinancials    Boolean @default(false)
  defaultCanEditFinancials    Boolean @default(false)
  defaultCanEditStatus        Boolean @default(true)

  members   TeamMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id           String  @id @default("singleton")
  whatsappLink String?
  meetingLink  String?
  orgName      String  @default("Z1Power")
}

model MeetingLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}
