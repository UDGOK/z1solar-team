generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TeamMember {
  id         String  @id @default(cuid())
  name       String
  title      String?
  email      String? @unique // Google sign-in identity AND email/password login
  phone      String?
  // Legacy field, retained so existing checks keep working during rollout.
  // "ADMIN" here still means full system access regardless of roleId.
  role       String  @default("MEMBER") // "MEMBER" | "ADMIN"
  roleId     String?
  customRole Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Email + password login (optional — a person can use Google instead, or both).
  // Set by the person themselves via an invite link; admins never see or set it.
  passwordHash       String?
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  leads                   Project[]            @relation("ProjectLead")
  ownedProjects           Project[]            @relation("ProjectOwner")
  memberships             ProjectMember[]
  access                  ProjectAccess[]
  assignedTodos           Todo[]               @relation("TodoAssignee")
  todoAssignments         TodoAssignee[]
  todosCompleted          Todo[]               @relation("TodoCompletedBy")
  todosConfirmed          Todo[]               @relation("TodoConfirmedBy")
  todoComments            TodoComment[]
  meetingImports          MeetingImport[]      @relation("ImportedBy")
  chatThreads             ChatThread[]
  purchasesRequested      PurchaseRequest[]    @relation("PurchaseRequester")
  purchasesApproved       PurchaseRequest[]    @relation("PurchaseApprover")
  purchasesSecondApproved PurchaseRequest[]    @relation("PurchaseSecondApprover")
  purchaseComments        PurchaseComment[]
  meetingsOrganized       Meeting[]            @relation("MeetingOrganizer")
  meetingAttendance       MeetingAttendee[]
  agendaOwned             MeetingAgendaItem[]  @relation("AgendaOwner")
  resourcesUploaded       Resource[]           @relation("ResourceUploader")
  createdTodos            Todo[]               @relation("TodoCreator")
  notifications           Notification[]       @relation("NotificationRecipient")
  sentMessages            Message[]            @relation("MessageSender")
  activities              Activity[]
  savedViews              SavedView[]
  tradeShowAttendance     TradeShowAttendee[]
  exhibitorsOwned         TradeShowExhibitor[] @relation("ExhibitorOwner")
  exhibitorNotes          ExhibitorNote[]      @relation("ExhibitorNoteAuthor")
  vendorsCreated          Vendor[]             @relation("VendorCreatedBy")
  exhibitorImports        ExhibitorImport[]    @relation("ExhibitorImportedBy")
  // Module-level access, set by an admin from the Trade Shows page.
  canViewTradeShows       Boolean              @default(true)
  canManageTradeShows     Boolean              @default(false)
  // Presence. Updated on page loads, throttled so it isn't a write per request.
  lastSeenAt              DateTime?
  // SMS. optedOut is set automatically when someone texts STOP — US law
  // requires we honour it immediately and never message them again.
  smsEnabled              Boolean              @default(true)
  smsOptedOut             Boolean              @default(false)
  smsMessages             SmsMessage[]         @relation("SmsMember")
  messageReceipts         MessageRecipient[]
  subscriptions           ReportSubscription[]
  emailOnTaskAssigned     Boolean              @default(true)
}

// Per-person, per-project weekly report subscription. Admin picks exactly
// which sections each person receives — a person can be subscribed to a
// project's status without ever seeing its financials, and vice versa.
model ReportSubscription {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  enabled           Boolean @default(true)
  includeStatus     Boolean @default(true)
  includeTasks      Boolean @default(true)
  includeKeyDates   Boolean @default(false)
  includeQuestions  Boolean @default(false)
  includeFinancials Boolean @default(false)

  lastSentAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, memberId])
}

model Project {
  id                String                      @id @default(cuid())
  title             String
  // Optional short label shown on the dashboard highlight card. Falls back to
  // `title` when empty, so existing projects are unaffected.
  highlightTitle    String?
  category          String // "Solar & Battery" | "Other Projects" | "Other Matters" | "New Project"
  leadId            String?
  lead              TeamMember?                 @relation("ProjectLead", fields: [leadId], references: [id])
  // Whoever created the project. Owners get full control of their own
  // projects without needing an explicit ProjectAccess row.
  ownerId           String?
  owner             TeamMember?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members           ProjectMember[]
  talkingPoints     TalkingPoint[]
  keyDates          KeyDate[]
  todos             Todo[]
  questions         OpenQuestion[]
  files             ProjectFile[]
  access            ProjectAccess[]
  lineItems         FinancialLineItem[]
  subscriptions     ReportSubscription[]
  exhibitorInterest TradeShowExhibitorProject[]
  meetings          Meeting[]
  smsMessages       SmsMessage[]
  meetingImports    MeetingImport[]
  purchases         PurchaseRequest[]

  // financials
  estBudget   Float   @default(0)
  committed   Float   @default(0)
  actualSpend Float   @default(0)
  q3Proj      Float   @default(0)
  q4Proj      Float   @default(0)
  q1Proj      Float   @default(0)
  q2Proj      Float   @default(0)
  notes       String?

  // Site / location
  address    String?
  city       String?
  state      String? // 2-letter, drives rebate lookups
  postalCode String?
  latitude   Float?
  longitude  Float?

  // Owner / client contact
  ownerName    String?
  ownerCompany String?
  ownerEmail   String?
  ownerPhone   String?
  ownerNotes   String?

  rebates    ProjectRebate[]
  activities Activity[]

  // Short reference code used for SMS routing ("MEAD: concrete poured") and
  // on POs and purchase records. Unique so a text can never be ambiguous.
  code String? @unique

  // Business priority, set by an admin. Nullable + defaulted so adding it is
  // purely additive — existing rows get "Medium" without a data migration.
  priority String @default("Medium") // High | Medium | Low

  // progress
  status        String @default("Planning") // "Planning" | "On Track" | "At Risk" | "Delayed" | "Complete"
  completionPct Int    @default(0) // 0-100, set by the project lead

  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      String?
  tasks     String?

  @@unique([projectId, memberId])
}

model TalkingPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  order     Int     @default(0)
}

model KeyDate {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone String
  date      DateTime?
  order     Int       @default(0)
}

model Todo {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean        @default(false)
  order      Int            @default(0)
  // Assignee does NOT need ProjectAccess on this project — a task can be
  // handed to anyone on the team. Their access to the task itself is what
  // grants them sight of it (see My Tasks).
  // DEPRECATED single-assignee field. Retained only so the seed script can
  // backfill existing rows into the TodoAssignee join table. Nothing reads
  // it at runtime — use `assignees` instead.
  assigneeId String?
  assignee   TeamMember?    @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignees  TodoAssignee[]

  // Completion is two-stage when it came out of a meeting: the assignee marks
  // it done, then the project lead confirms. Without that second step "done"
  // is just one person's claim, which is exactly what weekly meetings exist to
  // check.
  requiresConfirmation Boolean     @default(false)
  completedById        String?
  completedBy          TeamMember? @relation("TodoCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt          DateTime?
  confirmedById        String?
  confirmedBy          TeamMember? @relation("TodoConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt          DateTime?
  // Set when a lead rejects a completion, with the reason in the thread.
  reopenedAt           DateTime?

  comments            TodoComment[]
  meetingImportItemId String?

  sourceMeetingId String?
  sourceMeeting   Meeting?    @relation("MeetingTasks", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  createdById     String?
  createdBy       TeamMember? @relation("TodoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
}

// In-app notifications (bell + dashboard). Email delivery is layered on top
// of these rows later rather than replacing them.
// Many-to-many: a task can be assigned to several people at once.
model TodoAssignee {
  id         String     @id @default(cuid())
  todoId     String
  todo       Todo       @relation(fields: [todoId], references: [id], onDelete: Cascade)
  memberId   String
  member     TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedAt DateTime   @default(now())

  @@unique([todoId, memberId])
  @@index([memberId])
}

model Notification {
  id          String     @id @default(cuid())
  recipientId String
  recipient   TeamMember @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String // "TASK_ASSIGNED" | "TASK_DUE_SOON" | "GENERAL"
  title       String
  body        String?
  link        String? // where clicking it should take them
  read        Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([recipientId, read])
}

model OpenQuestion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  resolved  Boolean @default(false)
  order     Int     @default(0)
}

model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  pathname    String // needed to delete the blob later
  filename    String
  contentType String?
  size        Int
  uploadedAt  DateTime @default(now())
}

// Per-person, per-project permissions, set by an admin.
//
// IMPORTANT: this is a default-DENY model. Absence of a row means the member
// has NO access to that project at all — they won't see it anywhere. Admins
// bypass all of this and always see everything.
//
// `canView` is the master switch: without it, none of the other flags matter.
model ProjectAccess {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  canView              Boolean @default(false) // master switch — see the project at all
  canEditTalkingPoints Boolean @default(false)
  canEditKeyDates      Boolean @default(false)
  canEditTodos         Boolean @default(false)
  canEditQuestions     Boolean @default(false)
  canEditTeam          Boolean @default(false)
  canViewFiles         Boolean @default(false)
  canUploadFiles       Boolean @default(false)
  canViewFinancials    Boolean @default(false)
  canEditFinancials    Boolean @default(false)
  canEditStatus        Boolean @default(false) // status + completion %

  updatedAt DateTime @updatedAt

  @@unique([projectId, memberId])
}

// Project-level financial ledger. Each row is a budget line that can carry
// actual spend, so budget-vs-actual variance is computed per line rather than
// only in aggregate.
model FinancialLineItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String  @default("General") // e.g. Labor, Materials, Equipment, Permits
  description String
  vendor      String?

  // Budget side — amount is qty * unitCost, stored so historical rows keep
  // their value even if the formula changes later.
  qty          Float @default(1)
  unitCost     Float @default(0)
  budgetAmount Float @default(0)

  // Actual side
  actualAmount Float     @default(0)
  invoiceRef   String?
  paidDate     DateTime?
  status       String    @default("Planned") // Planned | Committed | Invoiced | Paid

  notes     String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Incentives tracked per project. Values are entered and verified by a human —
// nothing here is auto-guessed, because wrong incentive figures on a quote are
// worse than no figures.
model ProjectRebate {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  authority       String? // Federal / State / Utility / Local
  category        String    @default("Solar") // Solar | BESS | EV | Efficiency | Other
  incentiveType   String    @default("Percentage") // Percentage | PerWatt | Fixed | PerKWh
  value           Float     @default(0)
  estimatedAmount Float     @default(0)
  status          String    @default("Researching") // Researching | Eligible | Applied | Awarded | Denied
  sourceUrl       String?
  notes           String?
  verifiedAt      DateTime?
  order           Int       @default(0)

  @@index([projectId])
}

// Team messages and alerts. One Message row per send, with a MessageRecipient
// row per person so read state, dismissal, and deletion are all per-person —
// one recipient deleting a message never affects anyone else's copy.
model Message {
  id       String      @id @default(cuid())
  senderId String?
  sender   TeamMember? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  subject  String
  body     String
  // "MESSAGE" = normal team message
  // "ALERT"   = must be acknowledged; blocks with a modal on next login
  kind     String @default("MESSAGE")
  priority String @default("Normal") // Normal | High | Urgent

  // Threading — a reply points at the message it answers.
  parentId String?
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageThread")

  recipients MessageRecipient[]
  createdAt  DateTime           @default(now())

  @@index([createdAt])
}

model MessageRecipient {
  id        String     @id @default(cuid())
  messageId String
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  memberId  String
  member    TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  read           Boolean   @default(false)
  readAt         DateTime?
  // Alerts must be explicitly acknowledged before the popup stops appearing.
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  // Soft delete — hides it from this person only.
  deleted        Boolean   @default(false)

  @@unique([messageId, memberId])
  @@index([memberId, read])
}

// Immutable record of what happened on a project. Never edited or deleted by
// users — only appended. Powers the per-project activity feed.
model Activity {
  id        String      @id @default(cuid())
  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     TeamMember? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Denormalised so the feed still reads correctly after someone leaves.
  actorName String

  // e.g. "task.created", "financials.updated", "member.access_changed"
  action    String
  // Human-readable one-liner, pre-rendered at write time.
  summary   String
  // Optional structured detail (before/after values, ids).
  meta      String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

// A named, reusable filter across tasks or projects.
model SavedView {
  id        String     @id @default(cuid())
  ownerId   String
  owner     TeamMember @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  scope     String     @default("tasks") // "tasks" | "projects"
  // JSON blob of the filter state — kept opaque so adding new filter
  // dimensions later doesn't require a migration.
  filters   String
  shared    Boolean    @default(false) // visible to the whole team
  createdAt DateTime   @default(now())

  @@index([ownerId])
}

// Trade shows / industry events the team may attend.
model TradeShow {
  id          String  @id @default(cuid())
  name        String
  description String?

  startDate DateTime
  endDate   DateTime?
  // Free text rather than a time field — real listings say things like
  // "Expo hall 9am–5pm daily", which no time picker captures well.
  timeInfo  String?

  venue   String?
  city    String?
  state   String?
  country String? @default("USA")

  websiteUrl           String?
  registrationUrl      String?
  // Booth registration usually closes long before the show itself — this is
  // the date that actually causes problems when missed.
  registrationDeadline DateTime?

  priority      String  @default("Medium") // High | Medium | Low
  status        String  @default("Considering") // Considering | Registered | Attending | Attended | Skipped
  boothInfo     String?
  estimatedCost Float   @default(0)
  notes         String?

  attendees  TradeShowAttendee[]
  purchases  PurchaseRequest[]
  exhibitors TradeShowExhibitor[]
  imports    ExhibitorImport[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([startDate])
}

model TradeShowAttendee {
  id          String     @id @default(cuid())
  tradeShowId String
  tradeShow   TradeShow  @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)
  memberId    String
  member      TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  status String  @default("Tentative") // Confirmed | Tentative | Declined
  role   String? // e.g. "Booth lead", "Technical support"
  notes  String?

  @@unique([tradeShowId, memberId])
}

// A named set of capabilities an admin can define and assign, e.g.
// "Supervisor", "Sub-admin", "Field Tech". Two system roles (Administrator,
// Member) ship by default and can't be deleted.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  // System roles are protected from deletion/renaming.
  isSystem    Boolean @default(false)
  // Higher rank = more authority. Used to stop someone editing a role at or
  // above their own level.
  rank        Int     @default(10)

  // --- Global capabilities ---
  canCreateProjects    Boolean @default(false)
  canDeleteAnyProject  Boolean @default(false)
  canViewAllProjects   Boolean @default(false)
  canEditAllProjects   Boolean @default(false)
  canViewAllFinancials Boolean @default(false)
  canEditAllFinancials Boolean @default(false)
  canManageTeam        Boolean @default(false)
  canManageRoles       Boolean @default(false)
  canSendAlerts        Boolean @default(false)
  canManageTradeShows  Boolean @default(false)
  canViewReports       Boolean @default(false)
  canManageMeetings    Boolean @default(false)
  canViewMeetings      Boolean @default(true)
  canTakeMeetingNotes  Boolean @default(false)
  canManageResources   Boolean @default(false)
  canViewResources     Boolean @default(true)
  canManageCategories  Boolean @default(false)
  canViewSms           Boolean @default(false)
  canSendSms           Boolean @default(false)
  canManageSmsContacts Boolean @default(false)
  canRequestPurchases  Boolean @default(true)
  canApprovePurchases  Boolean @default(false)
  canViewAllPurchases  Boolean @default(false)
  canRecordPayments    Boolean @default(false)
  canViewAuditLog      Boolean @default(false)
  canRestoreBackup     Boolean @default(false)

  // --- Defaults applied when this person is granted a project ---
  defaultCanEditTalkingPoints Boolean @default(true)
  defaultCanEditKeyDates      Boolean @default(true)
  defaultCanEditTodos         Boolean @default(true)
  defaultCanEditQuestions     Boolean @default(true)
  defaultCanEditTeam          Boolean @default(false)
  defaultCanViewFiles         Boolean @default(true)
  defaultCanUploadFiles       Boolean @default(true)
  defaultCanViewFinancials    Boolean @default(false)
  defaultCanEditFinancials    Boolean @default(false)
  defaultCanEditStatus        Boolean @default(true)

  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Durable, unguessable links for externally sharing a generated PDF (the
// "Get Shareable Link" button). Blob storage is private-only, so a raw blob
// URL no longer works for someone outside the app — this is our own proxy:
// possession of the random token is what grants access, same security
// property as an unlisted public URL, but mediated by our server so we can
// also expire it.
model SharedLink {
  id          String    @id @default(cuid())
  token       String    @unique
  pathname    String
  filename    String
  contentType String    @default("application/pdf")
  projectId   String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([token])
}

// Project categories. Deliberately NOT a foreign key on Project — that column
// is a plain string on live data, and converting it would be a destructive
// migration. This table is the editable list; renames update both in one
// transaction, and a category can't be deleted while projects still use it.
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#8A8A85")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// A meeting moves through phases: scheduled -> agenda -> held -> notes.
// The UI changes shape per phase rather than showing one flat form.
model Meeting {
  id           String   @id @default(cuid())
  title        String
  description  String?
  startsAt     DateTime
  durationMins Int      @default(60)
  location     String?
  joinUrl      String?

  status  String    @default("Scheduled") // Scheduled | Held | Cancelled
  // Written after the meeting. Kept separate from description so the agenda
  // isn't overwritten by the minutes.
  notes   String?
  notesBy String?
  notesAt DateTime?

  organizerId String?
  organizer   TeamMember? @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  agendaItems MeetingAgendaItem[]
  imports     MeetingImport[]
  tasks       Todo[]              @relation("MeetingTasks")
  attendees   MeetingAttendee[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([startsAt])
}

model MeetingAgendaItem {
  id        String      @id @default(cuid())
  meetingId String
  meeting   Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  text      String
  order     Int         @default(0)
  // Ticked during the meeting so everyone can see what's been covered.
  covered   Boolean     @default(false)
  ownerId   String?
  owner     TeamMember? @relation("AgendaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
}

model MeetingAttendee {
  id           String     @id @default(cuid())
  meetingId    String
  meeting      Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId     String
  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status       String     @default("Invited") // Invited | Accepted | Declined | Attended
  // Per-meeting override: lets an admin give one person note-taking rights
  // for a single meeting without granting it globally via their role.
  canEditNotes Boolean    @default(false)

  @@unique([meetingId, memberId])
}

// Shared library: marketing flyers, spec sheets, knowledge base, templates.
// Holds either an uploaded file (private blob) or an external link.
model ResourceCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  icon        String     @default("folder")
  color       String     @default("#4CAB3E")
  order       Int        @default(0)
  items       Resource[]
  createdAt   DateTime   @default(now())
}

model Resource {
  id         String           @id @default(cuid())
  categoryId String
  category   ResourceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  title       String
  description String?
  // Exactly one of these is set. A flyer is a file; a knowledge-base article
  // is often just a URL, and forcing everything into one shape is worse.
  kind        String  @default("FILE") // FILE | LINK
  url         String?
  pathname    String?
  filename    String?
  contentType String?
  size        Int     @default(0)

  tags         String?
  uploadedById String?
  uploadedBy   TeamMember? @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categoryId])
}

// Approved external numbers (subcontractors, vendors, inspectors). Anything
// texting in from a number that is NOT a team member and NOT on this list is
// rejected — an open inbox would mean spam and cost with no upside.
model SmsContact {
  id          String       @id @default(cuid())
  phone       String       @unique
  name        String
  company     String?
  notes       String?
  active      Boolean      @default(true)
  optedOut    Boolean      @default(false)
  // Optional scoping: if set, this contact may only file messages against
  // these projects. Empty means any project.
  projectIds  String?
  createdById String?
  createdAt   DateTime     @default(now())
  messages    SmsMessage[] @relation("SmsContact")

  @@index([phone])
}

// Every inbound and outbound message. Idempotent on twilioSid because Twilio
// retries a webhook it thinks failed, which would otherwise duplicate rows.
model SmsMessage {
  id         String  @id @default(cuid())
  twilioSid  String? @unique
  direction  String // IN | OUT
  fromNumber String
  toNumber   String
  body       String
  status     String  @default("received") // received | queued | sent | delivered | failed
  errorText  String?

  projectId String?
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  memberId  String?
  member    TeamMember? @relation("SmsMember", fields: [memberId], references: [id], onDelete: SetNull)
  contactId String?
  contact   SmsContact? @relation("SmsContact", fields: [contactId], references: [id], onDelete: SetNull)

  // How the project was determined — useful when a message lands somewhere
  // unexpected and you need to know why.
  routedBy   String? // keyword | session | reply | manual | outbound
  mediaCount Int      @default(0)
  handled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// Remembers which project a number is currently talking about, so follow-up
// texts don't each need a prefix.
model SmsSession {
  id             String   @id @default(cuid())
  phone          String   @unique
  projectId      String?
  // Set when we've asked "which project?" so a bare digit reply can be
  // interpreted, along with the message we're still holding.
  pendingChoices String?
  pendingBody    String?
  lastTaskId     String?
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt
}

// A conversation on a task. This is what lets a project lead push back on a
// completion, and the assignee respond, without losing the history.
model TodoComment {
  id         String      @id @default(cuid())
  todoId     String
  todo       Todo        @relation(fields: [todoId], references: [id], onDelete: Cascade)
  authorId   String?
  author     TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  // Marks the system-generated entries ("marked done", "confirmed") so the
  // thread reads as a timeline rather than just chat.
  kind       String      @default("COMMENT") // COMMENT | COMPLETED | CONFIRMED | REOPENED
  createdAt  DateTime    @default(now())

  @@index([todoId])
}

// A pasted transcript or set of notes, plus what we extracted from it.
// Deliberately kept as a draft until a human accepts the items — auto-creating
// tasks from a misread line is worse than not extracting at all.
model MeetingImport {
  id        String   @id @default(cuid())
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title        String
  rawText      String
  source       String      @default("PASTE") // PASTE | TRANSCRIPT
  status       String      @default("DRAFT") // DRAFT | APPLIED
  importedById String?
  importedBy   TeamMember? @relation("ImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  appliedAt    DateTime?
  // Written by the AI pass when configured. Null just means rules-only, which
  // is a perfectly valid state — never an error.
  aiSummary    String?
  aiDecisions  String?
  aiUsed       Boolean     @default(false)
  aiError      String?
  createdAt    DateTime    @default(now())

  items MeetingImportItem[]
}

model MeetingImportItem {
  id       String        @id @default(cuid())
  importId String
  import   MeetingImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  text                 String
  // Everything below is a SUGGESTION shown for review, never applied blind.
  suggestedAssigneeIds String?
  suggestedDueDate     DateTime?
  matchedNames         String?
  // Why we thought this was an action item — shown in review so a wrong
  // extraction is obvious rather than mysterious.
  reason               String?
  confidence           String    @default("medium") // high | medium | low
  sourceLine           Int       @default(0)

  accepted      Boolean @default(true)
  // "rules" or "ai" — shown in review so a reviewer knows what found it.
  origin        String  @default("rules")
  createdTodoId String?
  order         Int     @default(0)
}

// A purchase request moving through approval. Money leaving the business is
// the highest-stakes thing this app touches, so every transition is recorded
// with who did it and when — the history is the point, not a side effect.
model PurchaseRequest {
  id     String @id @default(cuid())
  // Human-readable reference (PR-0001) for POs, invoices and conversations.
  // Assigned in the create action rather than autoincrement(), which Postgres
  // supports on a non-id field but SQLite doesn't — keeping them the same
  // means the behaviour tested locally is the behaviour that ships.
  number Int    @unique

  title       String
  description String?
  category    String // MATERIAL | TRADE_SHOW | MARKETING | SOFTWARE | TRAVEL | SUBCONTRACTOR | OFFICE | OTHER

  // Material and subcontractor spend must be attributable to a project;
  // enforced in the action, not just the UI.
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tradeShowId String?
  tradeShow   TradeShow? @relation(fields: [tradeShowId], references: [id], onDelete: SetNull)

  vendor        String?
  vendorContact String?
  quantity      Float     @default(1)
  unitCost      Float     @default(0)
  // Stored rather than derived so a historical record can't shift if someone
  // edits quantity later.
  amount        Float     @default(0)
  neededBy      DateTime?
  urgency       String    @default("Normal") // Normal | Urgent

  status String @default("DRAFT")
  // DRAFT | SUBMITTED | APPROVED | REJECTED | ORDERED | RECEIVED | INVOICED | PAID | CANCELLED

  requestedById String?
  requestedBy   TeamMember? @relation("PurchaseRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  approvedById       String?
  approvedBy         TeamMember? @relation("PurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  // Second sign-off for high-value requests.
  secondApprovedById String?
  secondApprovedBy   TeamMember? @relation("PurchaseSecondApprover", fields: [secondApprovedById], references: [id], onDelete: SetNull)
  secondApprovedAt   DateTime?
  rejectedAt         DateTime?

  orderedAt  DateTime?
  receivedAt DateTime?
  invoicedAt DateTime?
  paidAt     DateTime?
  poNumber   String?
  invoiceRef String?

  // Set when approval writes a committed line item into the project ledger,
  // so the two stay linked and we never double-post.
  lineItemId String? @unique

  // Snapshot of the budget position at approval time. Kept because the
  // budget will change later, and "was this reasonable when approved?" is the
  // question that actually gets asked.
  budgetAtApproval    Float?
  committedAtApproval Float?

  comments  PurchaseComment[]
  files     PurchaseFile[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([projectId])
}

model PurchaseComment {
  id         String          @id @default(cuid())
  purchaseId String
  purchase   PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     TeamMember?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String
  // SUBMITTED / APPROVED / REJECTED etc. render as timeline events rather
  // than chat, so the thread reads as an audit trail.
  kind       String          @default("COMMENT")
  createdAt  DateTime        @default(now())

  @@index([purchaseId])
}

// Quotes, POs, receipts and invoices. Private blob, same as project files.
model PurchaseFile {
  id           String          @id @default(cuid())
  purchaseId   String
  purchase     PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  pathname     String
  filename     String
  contentType  String?
  size         Int             @default(0)
  kind         String          @default("OTHER") // QUOTE | PO | RECEIPT | INVOICE | OTHER
  uploadedById String?
  createdAt    DateTime        @default(now())
}

// Append-only record of who changed what. Deliberately has no update or
// delete action anywhere in the codebase — an audit log you can edit isn't
// evidence. Actor name and entity label are denormalised so the record still
// reads correctly after the person or the record itself is gone.
model AuditLog {
  id String @id @default(cuid())

  entityType  String // Project | FinancialLineItem | PurchaseRequest | TeamMember | Role | Category | Settings
  entityId    String
  entityLabel String // e.g. the project title at the time of the change

  action String // CREATE | UPDATE | DELETE | APPROVE | REJECT | RESTORE | RECONCILE

  // Field-level detail for changes worth reconstructing later. Stored as JSON
  // text: [{ field, from, to }]
  changes String?
  // Human sentence for the timeline, e.g. "Budget $353,000 -> $400,000".
  summary String

  // Flags money-affecting changes so a financial review can filter to just
  // those without reading everything.
  isFinancial Boolean @default(false)

  actorId    String?
  actorName  String
  actorEmail String?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([isFinancial])
}

// Result of a committed-vs-line-items reconciliation run. Kept as a record so
// drift that appeared and was repaired is still visible afterwards.
model ReconciliationRun {
  id              String   @id @default(cuid())
  runBy           String?
  runByName       String
  projectsChecked Int      @default(0)
  driftFound      Int      @default(0)
  driftRepaired   Int      @default(0)
  // JSON detail of each discrepancy: project, stored, computed, difference.
  details         String?
  createdAt       DateTime @default(now())
}

// Failed sign-in attempts, used for rate limiting. Stored in the database
// rather than memory because serverless instances don't share state — an
// in-memory counter would reset constantly and enforce nothing.
model LoginAttempt {
  id         String   @id @default(cuid())
  // Lowercased email OR ip:<address> — we limit on both so neither a single
  // account nor a single source can be hammered.
  identifier String
  successful Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// Saved conversations with the assistant, so a question asked yesterday can
// be picked up today.
model ChatThread {
  id        String        @id @default(cuid())
  memberId  String
  member    TeamMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String        @default("New conversation")
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([memberId])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId])
}

model Settings {
  id           String  @id @default("singleton")
  whatsappLink String?
  meetingLink  String?
  orgName      String  @default("Z1Power")
}

model MeetingLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Trade show exhibitors / vendors
//
// A Vendor is a COMPANY and is global — deliberately not scoped to one show.
// The same firms exhibit year after year, and the value of this module is that
// "we met them at Datacloud USA and they quoted 22 week lead times" is still
// attached when they turn up at the next event. Show-specific facts (booth,
// whether we want a meeting this time, what it's about) live on
// TradeShowExhibitor instead.
//
// The cost of that split is deduplication on import: the same company arrives
// as "SUNGROW" one year and "Sungrow Power Supply Co., Ltd." the next. That's
// handled by matchKey below plus a review step that SUGGESTS a merge and never
// performs one silently.
// ---------------------------------------------------------------------------

model Vendor {
  id          String  @id @default(cuid())
  name        String
  // Normalised name used for duplicate detection: lowercased, punctuation and
  // legal suffixes (Inc, LLC, Ltd, Co, GmbH...) stripped. NOT unique — two
  // genuinely different companies can normalise the same way, and blocking
  // that at the database level would make an import fail instead of asking.
  matchKey    String
  description String?
  websiteUrl  String?
  hqCity      String?
  hqCountry   String?
  // Relationship notes that accumulate across every show.
  notes       String?

  // The source list's own category text, kept verbatim. Tags are a curated set
  // for filtering; this is what the show actually said, and is never discarded
  // just because the mapping put it in a broader bucket.
  sector String?

  // --- Standing / risk -----------------------------------------------------
  // 0-100. Nullable on purpose: "not assessed" and "scored zero" are very
  // different things and must never render the same way.
  reputationScore  Int?
  riskNotes        String?
  // Where the score came from: "manual" | "imported" | "ai". Stored because an
  // unsourced judgement about a named company is worse than no judgement — six
  // months on, nobody remembers which numbers were researched and which were
  // generated. The UI labels anything that isn't "manual" as unverified.
  riskSource       String?
  riskAssessedAt   DateTime?
  // Who last set it by hand, so a verified score is visibly different from an
  // inherited one.
  riskAssessedById String?

  createdById String?
  createdBy   TeamMember? @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tags        VendorTagLink[]
  contacts    VendorContact[]
  appearances TradeShowExhibitor[]
  importItems ExhibitorImportItem[] @relation("ImportItemMatchedVendor")

  @@index([matchKey])
  @@index([name])
}

// Admin-managed tag list ("Inverters", "BESS", "Cooling"...). Kept as a table
// rather than a string column so renaming a tag renames it everywhere and
// filtering is an index lookup instead of a LIKE over free text.
model VendorTag {
  id        String   @id @default(cuid())
  name      String   @unique
  // Lowercased name, used to catch case-only duplicates on create/rename.
  slug      String   @unique
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  vendors VendorTagLink[]
}

model VendorTagLink {
  vendorId String
  tagId    String
  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tag      VendorTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([vendorId, tagId])
  @@index([tagId])
}

model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([vendorId])
}

// One company at one show. Everything here is specific to that appearance.
model TradeShowExhibitor {
  id          String    @id @default(cuid())
  tradeShowId String
  tradeShow   TradeShow @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  booth       String?
  hall        String?
  // Exhibitor | Sponsor | Both — a company is often both, and the sponsor
  // list is usually published before the exhibitor list.
  listing     String  @default("Exhibitor")
  sponsorTier String?

  meetingWanted Boolean @default(false)
  // To arrange | Requested | Scheduled | Met | No longer needed
  meetingStatus String  @default("To arrange")
  priority      String  @default("Medium") // High | Medium | Low

  ownerId String?
  owner   TeamMember? @relation("ExhibitorOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // What we want out of them at THIS show.
  notes   String?
  // What actually happened, filled in after.
  outcome String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    TradeShowExhibitorProject[]
  noteEntries ExhibitorNote[]

  // One row per company per show. Import relies on this to update rather than
  // duplicate when the same list is imported twice.
  @@unique([tradeShowId, vendorId])
  @@index([tradeShowId, meetingWanted])
  @@index([ownerId])
}

// Which project(s) a meeting would be about. Many-to-many because a battery
// supplier can be relevant to three sites at once.
model TradeShowExhibitorProject {
  exhibitorId String
  projectId   String
  exhibitor   TradeShowExhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([exhibitorId, projectId])
  @@index([projectId])
}

// Timestamped notes captured on the floor. Append-only rather than one editable
// notes field, because two people at the same booth on different days both have
// something worth keeping and last-write-wins would silently destroy one.
model ExhibitorNote {
  id          String             @id @default(cuid())
  exhibitorId String
  exhibitor   TradeShowExhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  authorId    String?
  author      TeamMember?        @relation("ExhibitorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  body        String
  createdAt   DateTime           @default(now())

  @@index([exhibitorId])
}

// ---- Import staging -------------------------------------------------------
// Mirrors MeetingImport/MeetingImportItem. Parsed rows land here first and a
// human confirms them; nothing reaches Vendor/TradeShowExhibitor until the
// import is applied.

model ExhibitorImport {
  id          String    @id @default(cuid())
  tradeShowId String
  tradeShow   TradeShow @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)

  // FILE_CSV | FILE_XLSX | PASTE | PDF | MANUAL
  source    String  @default("FILE_CSV")
  fileName  String?
  // Kept for PASTE/PDF so a bad parse can be re-run without re-uploading.
  rawText   String?
  // JSON: which column in their file maps to which of our fields.
  columnMap String?
  status    String  @default("DRAFT") // DRAFT | APPLIED | DISCARDED

  importedById String?
  importedBy   TeamMember? @relation("ExhibitorImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  appliedAt    DateTime?

  // AI enrichment is optional. aiUsed=false with no error is a normal,
  // successful rules-only import — never treat it as a failure.
  aiUsed  Boolean @default(false)
  aiError String?

  createdAt DateTime              @default(now())
  items     ExhibitorImportItem[]

  @@index([tradeShowId])
}

model ExhibitorImportItem {
  id       String          @id @default(cuid())
  importId String
  import   ExhibitorImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  companyName  String
  booth        String?
  hall         String?
  websiteUrl   String?
  description  String?
  // Comma-separated suggested tag names, resolved to VendorTag on apply.
  tagNames     String?
  // The source list's own category text, carried through verbatim so the
  // mapping to curated tags never destroys what the show actually said.
  sector       String?
  contactName  String?
  contactEmail String?
  hqCountry    String?
  listing      String  @default("Exhibitor")
  sponsorTier  String?

  // Duplicate suggestion — shown for review, never auto-applied.
  matchedVendorId String?
  matchedVendor   Vendor? @relation("ImportItemMatchedVendor", fields: [matchedVendorId], references: [id], onDelete: SetNull)
  // Why we think it's a match, in words, so a wrong suggestion is obvious.
  matchReason     String?
  // exact | normalised | fuzzy | none
  matchKind       String  @default("none")

  confidence String  @default("high") // high | medium | low
  origin     String  @default("file") // file | rules | ai
  // Why a row was flagged low confidence — shown in review.
  reason     String?
  sourceLine Int     @default(0)

  accepted        Boolean @default(true)
  // What we did with it, filled in on apply.
  createdVendorId String?
  sortOrder       Int     @default(0)

  @@index([importId])
}
